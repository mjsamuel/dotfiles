[
  {
    "plugin_id": "mjsamuel.last-focus",
    "name": "Last Focus",
    "version": "0.1.0",
    "min_herdr_version": "0.8.0",
    "description": "Toggle back to the last-focused tab/workspace, tmux last-window/switch-client -l style",
    "manifest_path": "/Users/mattsamuel/Developer/dotfiles/config/herdr/plugins/last-focus/herdr-plugin.toml",
    "plugin_root": "/Users/mattsamuel/Developer/dotfiles/config/herdr/plugins/last-focus",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "toggle-tab",
        "title": "Toggle Last Tab",
        "command": [
          "lua",
          "toggle.lua",
          "tab"
        ]
      },
      {
        "id": "toggle-workspace",
        "title": "Toggle Last Workspace",
        "command": [
          "lua",
          "toggle.lua",
          "workspace"
        ]
      }
    ],
    "events": [
      {
        "on": "tab.focused",
        "command": [
          "lua",
          "record.lua",
          "tab"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "lua",
          "record.lua",
          "workspace"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]
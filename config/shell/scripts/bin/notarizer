#!/bin/sh
set -eu

notes_dir="${NOTES_DIR:-$HOME/Documents/notes}"
todo_dir="$notes_dir/todo"

main() {
	if [ ! -d "$notes_dir" ]; then
		printf "Notes directory '%s' does not exist\n" "$notes_dir" >&2
		exit 1
	fi

	mkdir -p "$todo_dir"
	today=$(date +%F)
	create_note "$today"
	ln -sfn "$today.md" "$todo_dir/today.md"

	cd "$notes_dir"
	exec nvim todo/today.md
}

create_note() {
	note_date="$1"
	note_path="$todo_dir/$note_date.md"
	[ -e "$note_path" ] && return

	heading="# $(pretty_date "$note_date")"
	previous_date=$(latest_note_before "$note_date")

	if [ -n "$previous_date" ]; then
		# Carry over the previous note, swapping in the new heading
		awk -v heading="$heading" '
			BEGIN { print heading }
			NR == 1 && /^# / { next }
			{ print }
		' "$todo_dir/$previous_date.md" >"$note_path"
	else
		cat <<-EOF >"$note_path"
			$heading

			- [ ] Write to-do list
		EOF
	fi
}

latest_note_before() {
	for note in "$todo_dir"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md; do
		[ -f "$note" ] || continue
		name="${note##*/}"
		printf '%s\n' "${name%.md}"
	done | LC_ALL=C sort -r | awk -v before="$1" '$0 < before { print; exit }'
}

# Prints a date like "Tuesday, 14th October 2025"
pretty_date() {
	format='%A %e %B %Y'
	# BSD date (macOS) first, then GNU date
	read -r weekday day month year <<-EOF
		$(date -j -f %F "$1" "+$format" 2>/dev/null || date -d "$1" "+$format")
	EOF

	case $day in
	1 | 21 | 31) suffix=st ;;
	2 | 22) suffix=nd ;;
	3 | 23) suffix=rd ;;
	*) suffix=th ;;
	esac

	echo "$weekday, $day$suffix $month $year"
}

main "$@"

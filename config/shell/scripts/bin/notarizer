#!/bin/sh
notes_dir="${NOTES_DIR:-$HOME/Documents/notes}"

main() {
	if [ ! -d "$notes_dir" ]; then
		printf "Notes directory '%s' does not exist..." "$notes_dir" >&2
		exit 1
	fi

	today=$(date +%F)
	tomorrow=$(date -v+1d +%F 2>/dev/null || date -d tomorrow +%F)
	create_tomorrows_note "$tomorrow" &

	todays_todo="$notes_dir/todo/$today.md"
	create_new_note "$todays_todo" "$today"
	ln -sfn "$today.md" "$notes_dir/todo/today.md"

	cd "$notes_dir" && exec nvim "todo/today.md"
}

create_new_note() {
	filepath="$1"
	note_date="$2"
	if [ -e "$filepath" ]; then
		return
	fi

	cat <<-EOF >"$filepath"
		# $(pretty_date "$note_date")

		- [ ] Write to-do list
	EOF
}

create_tomorrows_note() {
	tomorrow="$1"
	tomorrows_todo="$notes_dir/todo/$tomorrow.md"
	create_new_note "$tomorrows_todo" "$tomorrow"
	ln -sfn "$tomorrow.md" "$notes_dir/todo/tomorrow.md"
}

pretty_date() {
	note_date="$1"
	if date -j -f %F "$note_date" +%A >/dev/null 2>&1; then
		weekday=$(date -j -f %F "$note_date" +%A)
		month=$(date -j -f %F "$note_date" +%B)
		year=$(date -j -f %F "$note_date" +%Y)
		day=$(date -j -f %F "$note_date" +%e | tr -d ' ')
	else
		weekday=$(date -d "$note_date" +%A)
		month=$(date -d "$note_date" +%B)
		year=$(date -d "$note_date" +%Y)
		day=$(date -d "$note_date" +%e | tr -d ' ')
	fi
	case $day in
	1 | 21 | 31) suf=st ;;
	2 | 22) suf=nd ;;
	3 | 23) suf=rd ;;
	*) suf=th ;;
	esac
	echo "$weekday, ${day}${suf} $month $year"
}

main

#!/bin/sh
notes_dir="${NOTES_DIR:-$HOME/Documents/notes}"

main() {
	if [ ! -d "$notes_dir" ]; then
		printf "Notes directory '%s' does not exist..." "$notes_dir" >&2
		exit 1
	fi

	todays_todo="$notes_dir/todo/$(date -I).md"
	if [ ! -f "$todays_todo" ]; then
		cat <<-EOF >"$todays_todo"
			# $(pretty_date)

			- [ ] Write to-do list
		EOF
	fi
	nvim +"cd $notes_dir" "$todays_todo"
}

pretty_date() {
	weekday=$(date +%A)
	month=$(date +%B)
	year=$(date +%Y)
	day=$(date +%e | tr -d ' ')
	case $day in
	1 | 21 | 31) suf=st ;;
	2 | 22) suf=nd ;;
	3 | 23) suf=rd ;;
	*) suf=th ;;
	esac
	echo "$weekday, ${day}${suf} $month $year"
}

main
